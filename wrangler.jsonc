{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quang-tri-travel-agent",
  "account_id": "e32909be56be76cc20fdd85683683604",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "quang-tri-travel-agent",
    },
  ],
  "observability": { "enabled": true },
  "workers_dev": true,
  // Per-PR preview versions (CI uploads them with --preview-alias pr-<number>).
  "preview_urls": true,
  // Run near Google's API instead of at the visitor's nearest edge: the Gemini API
  // rejects calls from some regions ("User location is not supported for the API use").
  "placement": { "mode": "targeted", "region": "gcp:us-central1" },
  // Editor feedback (answer reports, content gaps) on D1's free plan. Schema: migrations/d1.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quang-tri-feedback",
      "database_id": "5ec6929c-dd98-4769-92e7-eb6372b716f3",
      "migrations_dir": "migrations/d1",
    },
  ],
  // Per-IP limits (lib/rate-limit.ts LIMITS), free on every plan. Period must be 10 or 60 s.
  "ratelimits": [
    { "name": "RL_CHAT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_VOICE", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_TTS", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_ROUTE", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_RECOMMEND", "namespace_id": "1005", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_REPORT", "namespace_id": "1006", "simple": { "limit": 10, "period": 60 } },
  ],
  // Non-secret settings. Secrets (API keys) go in with `wrangler secret put <NAME>`;
  // NEXT_PUBLIC_* values are inlined at build time, so set them in .env.local before deploying.
  "vars": {
    "AI_PROVIDER": "google",
    "GOOGLE_CHAT_MODEL": "gemini-2.5-flash-lite",
    "CONTENT_REQUIRE_REVIEWED": "false",
    "RATE_LIMIT": "on",
  },
}
