# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI provider: "google" or "openai". Unset = whichever key below is set (Google first).
# Switching provider changes the embedding space: re-run `bun run ingest`.
AI_PROVIDER=

# Google Gemini (free key: https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=
# flash-lite: higher free-tier quota than gemini-2.5-flash (5 req/min)
GOOGLE_CHAT_MODEL=gemini-2.5-flash-lite
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
# Speech-to-text model (defaults to GOOGLE_CHAT_MODEL)
GOOGLE_STT_MODEL=
# pgvector match threshold; default 0.6 for Gemini, 0.25 for OpenAI
VECTOR_MIN_SIMILARITY=

# OpenAI (optional with Google; TTS uses it when set, else the browser speaks)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_STT_MODEL=whisper-1

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=pk....

# Upstash Redis (rate limit)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Web search (optional)
TAVILY_API_KEY=

# PostHog (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Mapbox Directions for real drive times (optional; falls back to estimates)
MAPBOX_SECRET_TOKEN=

# Content governance (set both in production; see docs/CONTENT_GUIDE.md)
# true: the agent ignores sections still marked review_status: draft
CONTENT_REQUIRE_REVIEWED=false
# 1: ingest refuses to run while any section is a draft
INGEST_REQUIRE_REVIEWED=0

# Rate limiting: "off" disables it (tests only). Uses Upstash above when set, else in-memory.
RATE_LIMIT=on
