{
  "name": "quang-tri-travel-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "bun run content:bundle",
    "dev": "next dev --turbo",
    "prebuild": "bun run content:bundle",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "pretypecheck": "bun run content:bundle",
    "typecheck": "tsc --noEmit",
    "pretest": "bun run content:bundle",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest": "bun run scripts/ingest.ts",
    "content:check": "bun run scripts/check-content.ts",
    "preeval": "bun run content:bundle",
    "eval": "bun --conditions=react-server run scripts/eval.ts",
    "format": "prettier --write .",
    "content:bundle": "bun run scripts/bundle-content.ts",
    "preview": "bun run content:bundle && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "bun run content:bundle && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "mobile:assets": "bun run scripts/mobile-assets.ts",
    "mobile:sync": "cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "store:screenshots": "bun run scripts/store-screenshots.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^1.2.22",
    "@ai-sdk/openai": "^1.0.0",
    "@ai-sdk/react": "^1.2.12",
    "@capacitor/core": "^8",
    "@capacitor/geolocation": "^8",
    "@capacitor/splash-screen": "^8",
    "@opennextjs/cloudflare": "^1.20.9",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.0",
    "@upstash/ratelimit": "^2.0.0",
    "@upstash/redis": "^1.34.0",
    "ai": "^4.0.0",
    "gray-matter": "^4.0.3",
    "mapbox-gl": "^3.7.0",
    "next": "^15.1.0",
    "next-intl": "^3.26.0",
    "openai": "^4.73.0",
    "posthog-js": "^1.205.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@capacitor/android": "^8",
    "@capacitor/cli": "^8",
    "@capacitor/ios": "^8",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.1.0",
    "@types/mapbox-gl": "^3.4.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "happy-dom": "^15.11.0",
    "playwright": "1.56.1",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.148.0"
  },
  "engines": {
    "node": ">=20"
  }
}
